{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./electron/preload/types.ts",
      "./electron/env.d.ts"
    ],
    "noEmit": true
  },
  "include": [
    "electron.vite.config.*",
    "electron/env.d.ts",
    "electron/main*",
    "electron/preload*"
  ],
  "exclude": [
    "src*"
  ],
  "files": [
    "src/manual-chunks.ts"
  ]
}
